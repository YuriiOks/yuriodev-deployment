# prod: public, non-secret backend config (tracked). Secrets go in env/prod.secrets.env (gitignored).
ENVIRONMENT=prod
API_TITLE="YuriODev Website API"
API_VERSION="0.1.0"
CORS_ORIGINS=["https://yuriodev.co.uk"]
LOG_LEVEL=INFO

# Social feed from Typefully (TYPEFULLY_API_KEY lives in env/prod.secrets.env)
SOCIAL_FEED_ENABLED=true
SOCIAL_FEED_PROVIDER=typefully
TYPEFULLY_SOCIAL_SET_ID=334563
