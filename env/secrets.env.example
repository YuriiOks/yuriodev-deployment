# Template for env/<env>.secrets.env (gitignored; create on the machine that runs that environment, mode 600).
# List secret variable NAMES here with empty values; never put a real value in this tracked file.
# Compose loads env/<env>.env first, then env/<env>.secrets.env (optional), so a secret overrides nothing public.
# Later: the same filenames can be encrypted in place with SOPS + age.
#
# EXAMPLE_API_KEY=
#
# Social feed (GET /api/posts), prod only, in env/prod.secrets.env. Read only when
# SOCIAL_FEED_PROVIDER=typefully. Typefully keys carry the creating user's full permissions
# (they can publish), so treat it as a full credential: create it in Typefully (Settings -> API),
# type it straight into the file on the box, never paste it anywhere else.
TYPEFULLY_API_KEY=

# Dashboards data API (/api/dashboards/**, /api/mcp). Off unless DATABASE_URL is set. Real values go
# in env/<env>.secrets.env on the box, generated there and never printed (deploy/README.md,
# "Dashboards database"). POSTGRES_PASSWORD is read by the postgres container of that environment.
# DATABASE_URL=postgresql://dashboards:<POSTGRES_PASSWORD>@yuriodev-<env>-postgres:5432/dashboards
# (prod host: yuriodev-postgres; a password with URL-special characters must be percent-encoded).
DATABASE_URL=
POSTGRES_PASSWORD=
# Shared secret for the X-Dashboards-Token header (MCP clients, scripts). dev/stage may rely on
# DASHBOARDS_TRUST_PROXY_AUTH=true (tracked in env/dev.env) instead; prod needs the token.
DASHBOARDS_API_TOKEN=
# Optional, not secret (so it belongs in env/<env>.env): DASHBOARDS_TIMEZONE=Europe/London decides what "today" is.

# Collectors (backend/src/dashboards/collectors): turn work items into tasks on their own. They run
# only when DATABASE_URL is set, and each one only when its credential is set. Secrets file only:
# a token can read your work, and GITHUB_SEARCH_SCOPE would put an organisation name in a public file.
# GitHub: PRs you opened and PRs waiting for your review. Minimum token: a fine-grained token with
# read-only "Pull requests" and "Metadata" on the repositories to watch (classic: `repo` for private
# repositories, `public_repo` for public ones).
GITHUB_TOKEN=
# Where its tasks go: personal or work-1 (the default). work-2 is refused.
# GITHUB_SPACE=work-1
# Appended to both searches, for example org:<name>:
# GITHUB_SEARCH_SCOPE=
# Linear: issues assigned to you that are not completed or canceled. A personal API key with
# read-only access (Settings -> Account -> Security & access -> Personal API keys).
LINEAR_API_KEY=
# LINEAR_SPACE=work-1
# Seconds between polls (30..86400, default 300):
# DASHBOARDS_COLLECT_INTERVAL_SECONDS=300

# Calendar collector: events from read-only secret iCal addresses (Google Calendar: Settings for the
# calendar -> Integrate calendar -> "Secret address in iCal format"). Each setting is a
# comma-separated list of https URLs, one per calendar. The URLs are credentials (anyone with one
# can read the calendar): secrets file only. work-2 has no calendar setting: it stays manual.
CALENDAR_ICS_PERSONAL=
CALENDAR_ICS_WORK_1=
# Your own address(es), comma-separated: events you declined in the feed are skipped.
# CALENDAR_OWNER_EMAILS=

# Finance (backend/src/dashboards/finance): a read-only copy of your bank data in its own schema.
# Runs only with DATABASE_URL set and a token below; ships dark, switch it on only where the server
# is behind Cloudflare Access. Secrets file only: the token shows your whole history.
# Monobank personal API token (https://api.monobank.ua/):
MONOBANK_TOKEN=
# How many months of history the first import fetches (0..36, default 12):
# FINANCE_BACKFILL_MONTHS=12
# Seconds between finance ticks, one provider request at most each (60..3600, default 90):
# FINANCE_POLL_INTERVAL_SECONDS=90

# Display names of the spaces on the dashboards, instead of "Work 1" / "Work 2": a JSON object with
# the keys personal, work-1, work-2 (all optional), each value 1 to 24 printable characters. Invalid
# entries are ignored one by one and never stop the backend. It lives here, not in a tracked file,
# so real names stay out of the public repo (the values below are invented).
# DASHBOARDS_SPACE_NAMES={"work-1": "Acme", "work-2": "Globex"}

# Icons of the spaces, drawn instead of the letter or number tile: a JSON object keyed by personal,
# work-1, work-2 (all optional) whose values are base64 data URIs of an image, at most 48 KiB each:
# data:image/png;base64, data:image/svg+xml;base64, data:image/x-icon;base64,
# data:image/vnd.microsoft.icon;base64, data:image/webp;base64, . Anything else (a link, another type,
# a bad payload, too big) is dropped for that space only and never stops the backend. Kept here so
# real logos stay out of the public repo (the value below is an invented 1x1 PNG).
# DASHBOARDS_SPACE_ICONS={"work-1": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="}
