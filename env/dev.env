# dev: public, non-secret backend config (tracked). Secrets go in env/dev.secrets.env (gitignored).
ENVIRONMENT=dev
API_TITLE="YuriODev Website API (dev)"
API_VERSION="0.1.0"
CORS_ORIGINS=["https://dev.yuriodev.co.uk"]
LOG_LEVEL=DEBUG
# Social feed preview with the synthetic fixture (no network, no key)
SOCIAL_FEED_ENABLED=true
SOCIAL_FEED_PROVIDER=fixture

# Dashboards: nginx basic auth already authenticated the caller (never set in prod).
DASHBOARDS_TRUST_PROXY_AUTH=true
# Where a browser reaches this backend: the OAuth redirect address of Monzo is built from it.
DASHBOARDS_PUBLIC_BASE_URL=https://dev.yuriodev.co.uk
