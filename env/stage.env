# stage: public, non-secret backend config (tracked). Secrets go in env/stage.secrets.env (gitignored).
ENVIRONMENT=stage
API_TITLE="YuriODev Website API (stage)"
API_VERSION="0.1.0"
CORS_ORIGINS=["https://stage.yuriodev.co.uk"]
LOG_LEVEL=INFO
# Social feed preview with the synthetic fixture (no network, no key)
SOCIAL_FEED_ENABLED=true
SOCIAL_FEED_PROVIDER=fixture
