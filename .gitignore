# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Purged paths
.docs/
yuriodev-portfolio/
yuriodev.html

# All Markdown except README.md in repo root
*.md
!README.md

# Environment files
.env
.env.*
!.env.example
!.env.*.template
# env/<env>.env is tracked (public config); env/<env>.secrets.env never is.
env/*.secrets.env

# Secrets and private material that must never be committed (this repo is public)
certbot/
certs/
nginx-proxy/auth/
deploy/*/*.env
*.pem
*.key
*.tar.gz
__MACOSX/
/docs/backlog.md
/docs/history/

# Claude Code: share the project config, keep personal/local state out.
# Must stay below the `*.md` rule above: the last matching pattern wins.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/*.sh
!.claude/scripts/
.claude/scripts/*
!.claude/scripts/*.sh
!.claude/commands/
!.claude/agents/
!.claude/rules/
!.claude/commands/*.md
!.claude/agents/*.md
!.claude/rules/*.md
!/CLAUDE.md
!/ERRORS.md
CLAUDE.local.md

# Build and runtime byproducts
__pycache__/
*.pyc
*.tsbuildinfo
backend/logs/
