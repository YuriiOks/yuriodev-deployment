# Keep the build context small and secret-free.
.env
.env.*
!.env.example

# Python caches and virtualenvs
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage*
htmlcov
.venv
venv

# Tests never ship in any image; requirements-dev.txt is needed in the
# build context because the `dev` Dockerfile stage installs it.
tests

# Editor, OS and VCS
.vscode
.idea
*.sw?
.DS_Store
.git
.gitignore

# Docs and docker files
*.md
!README.md
*.html
Dockerfile
.dockerignore
